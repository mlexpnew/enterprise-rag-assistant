CLAUSEWISE_POLICY_DIR=./my_policies
CLAUSEWISE_KEYS=emp-key:employee,mgr-key:manager,hr-key:hr
# optional
CLAUSEWISE_SEMANTIC=1              # meaning-based search (pip install "clausewise[semantic]")
CLAUSEWISE_SEM_THRESHOLD=0.5       # use the threshold the benchmark picks on your dev questions
CLAUSEWISE_LLM=groq                # plain-words phrasing, numbers checked against the clause
GROQ_API_KEY=
